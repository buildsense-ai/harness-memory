DATABASE_URL=postgresql://harness_memory:CHANGE_ME@127.0.0.1:5432/harness_memory
HOST=127.0.0.1
PORT=8460
MODEL_BASE_URL=https://YOUR_PROVIDER/v1
MODEL_API_KEY=CHANGE_ME
MODEL_NAME=YOUR_MODEL
MODEL_INPUT_BUDGET=65536
MODEL_MAX_OUTPUT_TOKENS=131072
# Ingestion reset fence. Set this before enabling the matching XiaoBa uploader.
MEMORY_DATASET_ID=your-rebuild-id
# Server-owned workspace for keyless Bot UID uploads; callers do not configure a project.
MEMORY_BOT_PROJECT_ID=prj_bot_uploads
MEMORY_STAGE1_CONCURRENCY=2
MEMORY_STAGE2_CONCURRENCY=6
MEMORY_MODEL_CONCURRENCY=6
MEMORY_STAGE2_HIGH_WATER=1000
MODEL_CONTEXT_TOKENS=1048576
MODEL_CONTEXT_MARGIN=37504
MEMORY_STAGE1_TARGET_TOKENS=200000
MEMORY_STAGE2_TARGET_TOKENS=880000
# Matching model tokenizer.json. Without it, conservative UTF-8 byte counting is used.
MODEL_TOKENIZER_FILE=/opt/harness-memory/tokenizer/tokenizer.json
