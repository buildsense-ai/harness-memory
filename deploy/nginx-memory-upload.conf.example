# Public upload ingress. Both names use one SAN certificate.
# Keep the application on loopback and retain any existing internal ingress.
server {
    listen 18443 ssl;
    server_name memory.catsco.cn memory.catsco.cc;

    ssl_certificate /etc/letsencrypt/live/memory.catsco/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/memory.catsco/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MemoryUploadTLS:10m;
    ssl_session_timeout 1d;

    client_max_body_size 4m;
    add_header X-Content-Type-Options nosniff always;

    location = /v1/bot-ingest/config {
        proxy_pass http://127.0.0.1:8460;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location ~ ^/v1/bots/[0-9]+/ingest/(manifests|batches|fragments)$ {
        proxy_pass http://127.0.0.1:8460;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    include /etc/nginx/snippets/memory-catsco-read*.conf;
    include /etc/nginx/snippets/memory-bot-read*.conf;

    location / { return 404; }
}
