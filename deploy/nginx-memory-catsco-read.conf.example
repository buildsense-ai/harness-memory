# Install as /etc/nginx/snippets/memory-catsco-read.conf. Replace the
# example IP with the production Cats Company API container's egress IP.
location ~ ^/internal/catsco/memory/(catalog|wiki)$ {
    allow 192.0.2.10;
    deny all;

    limit_except POST { deny all; }
    client_max_body_size 256k;
    proxy_pass http://127.0.0.1:8460;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_read_timeout 8s;
}
