# Optional. Install under /etc/nginx/snippets/memory-bot-read.conf.
location ~ "^/v1/bot-memory/(search|wikis/mem_[0-9A-Fa-f-]{36}(/source)?)$" {
    client_max_body_size 24k;
    proxy_pass http://127.0.0.1:8460;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_read_timeout 20s;
}
